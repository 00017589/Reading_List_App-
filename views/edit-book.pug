extends layout

block content
  h1.mb-4(style="color: rgb(108, 117, 125);") Edit Book
  
  if errors
    .alert.alert-danger
      ul.mb-0
        each error in errors
          li= error.msg
  
  .card.border-secondary.bg-light
    .card-body
      form(action=`/books/edit/${book.id}`, method="POST")
        .mb-3
          label.form-label(for="title") Title *
          input.form-control#title(type="text", name="title", value=book.title, required)
        
        .mb-3
          label.form-label(for="author") Author *
          input.form-control#author(type="text", name="author", value=book.author, required)
        
        .mb-3
          label.form-label(for="genre") Genre *
          select.form-select#genre(name="genre", required)
            each genre in ['Fiction', 'Non-Fiction', 'Science Fiction', 'Fantasy', 'Mystery', 'Thriller', 'Romance', 'Biography', 'History', 'Self-Help', 'Business', 'Other']
              option(value=genre, selected=book.genre === genre)= genre
        
        .mb-3
          label.form-label(for="status") Status *
          select.form-select#status(name="status", required)
            each status in ['To Read', 'Reading', 'Completed']
              option(value=status, selected=book.status === status)= status
        
        .mb-3
          label.form-label(for="notes") Notes
          textarea.form-control#notes(name="notes", rows="3")= book.notes
        
        .d-flex.gap-2
          button.btn(type="submit", style="background-color: rgb(108, 117, 125); border-color: rgb(108, 117, 125); color: white;") Update Book
          a.btn.btn-outline-secondary(href="/") Cancel
