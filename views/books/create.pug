extends ../layout

block content
  .row.justify-content-center
    .col-md-8
      .card
        .card-header
          h2.text-center Add New Book
        .card-body
          form.book-form(action='/books', method='POST')
            .mb-3
              label.form-label(for='title') Title *
              input#title.form-control(type='text', name='title', required)
            
            .mb-3
              label.form-label(for='author') Author *
              input#author.form-control(type='text', name='author', required)
            
            .mb-3
              label.form-label(for='genre') Genre
              input#genre.form-control(type='text', name='genre')
            
            .mb-3
              label.form-label(for='status') Status
              select#status.form-select(name='status')
                option(value='to read') To Read
                option(value='reading') Currently Reading
                option(value='completed') Completed
              
              .mt-2
                span#status-badge-preview.badge.bg-secondary To Read
            
            .mb-3
              label.form-label(for='notes') Notes
              textarea#notes.form-control(name='notes', rows='4')
            
            .d-flex.justify-content-between
              a.btn.btn-secondary(href='/books') Cancel
              button.btn.btn-primary(type='submit') Add Book