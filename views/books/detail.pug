extends ../layout

block content
  .card
    .card-body
      .d-flex.justify-content-between.align-items-start.mb-3
        h1.card-title= book.title
        .d-flex
          a.btn.btn-outline-secondary.me-2(href=`/books/${book._id}/edit`) Edit
          form(action=`/books/${book._id}?_method=DELETE`, method='POST')
            button.btn.btn-outline-danger(type='submit', onclick='return confirmDelete()') Delete
      
      h4.text-muted= book.author
      
      if book.genre
        p.mb-3
          strong Genre: 
          = book.genre
      
      p.mb-3
        strong Status: 
        span.badge(class=book.status === 'to read' ? 'bg-secondary' : book.status === 'reading' ? 'bg-primary' : 'bg-success')= book.status
      
      if book.notes
        .mb-4
          h5 Notes
          p.card-text= book.notes
      
      p.small.text-muted Added on #{new Date(book.createdAt).toLocaleDateString()}
      
      .mt-4
        a.btn.btn-primary(href='/books') Back to List