doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title #{title} - Reading List App
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet', href='/styles/style.css')
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
      .container
        a.navbar-brand(href='/') Reading List App
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav')
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav.ms-auto
            if user
              li.nav-item
                a.nav-link(href='/books') My Books
              li.nav-item
                a.nav-link(href='/books/new') Add Book
              li.nav-item
                a.nav-link(href='/users/logout') Logout
            else
              li.nav-item
                a.nav-link(href='/users/login') Login
              li.nav-item
                a.nav-link(href='/users/register') Register
    
    .container
      if success_msg && success_msg.length > 0
        .alert.alert-success.alert-dismissible.fade.show
          = success_msg
          button.btn-close(type='button', data-bs-dismiss='alert')
      
      if error_msg && error_msg.length > 0
        .alert.alert-danger.alert-dismissible.fade.show
          = error_msg
          button.btn-close(type='button', data-bs-dismiss='alert')
      
      if error && error.length > 0
        .alert.alert-danger.alert-dismissible.fade.show
          = error
          button.btn-close(type='button', data-bs-dismiss='alert')
          
      if errors
        each error in errors
          .alert.alert-danger.alert-dismissible.fade.show
            = error.msg
            button.btn-close(type='button', data-bs-dismiss='alert')
      
      block content
      
    footer.bg-dark.text-light.mt-5.py-3
      .container.text-center
        p This web application was created to fulfill Web Technology module's requirements and does not represent an actual company or service.
        
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
    script(src='/javascripts/script.js')