extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .card
          .card-header.bg-primary.text-white
            h3 Reset Password
          .card-body
            if error_msg
              .alert.alert-danger= error_msg
            if success_msg
              .alert.alert-success= success_msg
              
            p Enter your email address and we'll send you a link to reset your password.
            
            form(action="/users/forgot-password", method="POST")
              .form-group.mb-3
                label(for="email") Email Address
                input.form-control#email(type="email", name="email", placeholder="Enter your email", required)
              button.btn.btn-primary.btn-block.w-100.mt-3(type="submit") Send Reset Link
              
            .mt-4.text-center
              p Remember your password? 
                a(href="/users/login") Login