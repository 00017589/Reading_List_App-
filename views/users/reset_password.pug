extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .card
          .card-header.bg-primary.text-white
            h3 Reset Password
          .card-body
            if error_msg
              .alert.alert-danger= error_msg
            
            form(action="/users/reset-password/#{token}", method="POST")
              .form-group.mb-3
                label(for="password") New Password
                input.form-control#password(type="password", name="password", placeholder="Choose a new password", required, minlength="6")
              .form-group.mb-3
                label(for="password2") Confirm Password
                input.form-control#password2(type="password", name="password2", placeholder="Confirm your new password", required, minlength="6")
              button.btn.btn-primary.btn-block.w-100.mt-3(type="submit") Reset Password