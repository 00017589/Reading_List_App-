extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .card
          .card-header.bg-primary.text-white
            h3 Register
          .card-body
            if error_msg
              .alert.alert-danger= error_msg
            if success_msg
              .alert.alert-success= success_msg
              
            form(action="/users/register", method="POST")
              .form-group.mb-3
                label(for="username") Username
                input.form-control#username(type="text", name="username", placeholder="Choose a username", required)
              .form-group.mb-3
                label(for="email") Email Address
                input.form-control#email(type="email", name="email", placeholder="Enter your email", required)
              .form-group.mb-3
                label(for="password") Password
                input.form-control#password(type="password", name="password", placeholder="Choose a password", required, minlength="6")
              .form-group.mb-3
                label(for="password2") Confirm Password
                input.form-control#password2(type="password", name="password2", placeholder="Confirm your password", required, minlength="6")
              button.btn.btn-primary.btn-block.w-100.mt-3(type="submit") Register
              
            .mt-4.text-center
              p Already have an account? 
                a(href="/users/login") Login