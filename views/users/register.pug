extends ../layout

block content
  .row.justify-content-center
    .col-md-6
      .card
        .card-header
          h3.text-center Register
        .card-body
          form(action='/users/register', method='POST')
            .mb-3
              label.form-label(for='name') Name
              input#name.form-control(type='text', name='name', value=name || '', required)
              
            .mb-3
              label.form-label(for='email') Email
              input#email.form-control(type='email', name='email', value=email || '', required)
            
            .mb-3
              label.form-label(for='password') Password
              input#password.form-control(type='password', name='password', required)
              small.form-text.text-muted Password must be at least 6 characters
            
            .mb-3
              label.form-label(for='password2') Confirm Password
              input#password2.form-control(type='password', name='password2', required)
            
            .d-grid.gap-2
              button.btn.btn-primary(type='submit') Register
          
          hr
          p.text-center Already have an account? 
            a(href='/users/login') Login