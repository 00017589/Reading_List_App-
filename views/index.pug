extends layout

block content
  .row.justify-content-center.align-items-center.min-vh-50
    .col-md-8.text-center
      h1.display-4.mb-4 Welcome to Reading List App
      p.lead Track your reading journey with our easy-to-use Reading List App!
      
      if !user
        .mt-4
          a.btn.btn-primary.me-2(href='/users/login') Login
          a.btn.btn-outline-primary(href='/users/register') Register
      else
        .mt-4
          a.btn.btn-primary.me-2(href='/books') View My Books
          a.btn.btn-outline-primary(href='/books/new') Add New Book
      
      .row.mt-5
        .col-md-4
          .card.mb-4
            .card-body.text-center
              i.fas.fa-book.fa-3x.mb-3.text-primary
              h3 Track Your Books
              p Add books you want to read, are currently reading, or have completed.
        .col-md-4
          .card.mb-4
            .card-body.text-center
              i.fas.fa-list-check.fa-3x.mb-3.text-primary
              h3 Organize by Status
              p Sort your books based on reading status to stay organized.
        .col-md-4
          .card.mb-4
            .card-body.text-center
              i.fas.fa-notes.fa-3x.mb-3.text-primary
              h3 Personal Notes
              p Add notes and thoughts about each book you're reading.