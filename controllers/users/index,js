const userService = require('../../services/users/index');

// user registration
exports.register = async (req, res, next) => {
  try {
    const { username, email, password } = req.body;
    await userService.createUser(username, email, password);
    req.flash('success_msg', 'You are now registered and can log in');
    res.redirect('/users/login');
  } catch (error) {
    req.flash('error_msg', error.message);
    res.redirect('/users/register');
  }
};

// user login
exports.login = (req, res, next) => {
  try {
    userService.authenticateUser(req.body.email, req.body.password)
      .then(user => {
        // create session
        req.session.user = user;
        req.flash('success_msg', 'You are now logged in');
        res.redirect('/');
      })
      .catch(err => {
        req.flash('error_msg', 'Invalid email or password');
        res.redirect('/users/login');
      });
  } catch (error) {
    next(error);
  }
};

// user logout
exports.logout = (req, res) => {
  req.session.destroy(() => {
    res.redirect('/users/login');
  });
};

// authentication middleware
exports.isAuthenticated = (req, res, next) => {
  if (req.session.user) {
    return next();
  }
  req.flash('error_msg', 'Please log in to view this resource');
  res.redirect('/users/login');
};

// getting user profile
exports.getProfile = async (req, res) => {
  try {
    const user = await userService.getUserById(req.session.user.id);
    res.render('users/profile', { user });
  } catch (error) {
    req.flash('error_msg', 'Error retrieving profile');
    res.redirect('/');
  }
};

// updating user profile
exports.updateProfile = async (req, res) => {
  try {
    const { username, email } = req.body;
    await userService.updateUser(req.session.user.id, { username, email });
    req.flash('success_msg', 'Profile updated successfully');
    res.redirect('/users/profile');
  } catch (error) {
    req.flash('error_msg', error.message);
    res.redirect('/users/profile');
  }
};

// password reset request
exports.forgotPassword = async (req, res) => {
  try {
    const { email } = req.body;
    await userService.requestPasswordReset(email);
    req.flash('success_msg', 'Password reset email sent');
    res.redirect('/users/login');
  } catch (error) {
    req.flash('error_msg', error.message);
    res.redirect('/users/forgot-password');
  }
};

// processing password reset
exports.resetPassword = async (req, res) => {
  try {
    const { token } = req.params;
    const { password } = req.body;
    await userService.resetPassword(token, password);
    req.flash('success_msg', 'Password has been updated');
    res.redirect('/users/login');
  } catch (error) {
    req.flash('error_msg', error.message);
    res.redirect('/users/reset-password/' + req.params.token);
  }
};